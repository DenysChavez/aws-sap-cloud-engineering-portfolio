{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheLabBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::denys-iam-lab-1234"
    },
    {
      "Sid": "ReadObjectsInTheLabBucket",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::denys-iam-lab-1234/*"
    }
  ]
}
